{
  "name": "jarl",
  "version": "1.0.0",
  "description": "Just Another React Library - Modern, accessible React component library",
  "private": true,
  "scripts": {
    "styles:generate": "pnpm --filter @jarl/styled-system codegen",
    "build": "turbo run build",
    "dev": "pnpm styles:generate && turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo cache",
    "storybook": "pnpm --filter @jarl/playground storybook",
    "docs:dev": "pnpm --filter @jarl/docs dev",
    "docs:build": "pnpm --filter @jarl/docs build",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "keywords": [
    "react",
    "components",
    "library",
    "a11y",
    "accessible"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@changesets/cli": "^2.29.8",
    "@types/react": "^19.2.13",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
