{
  "name": "@jarl/button",
  "version": "0.0.0",
  "type": "module",
  "description": "Accessible button primitive for Jarl",
  "homepage": "https://naimikan.github.io/jarl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naimikan/jarl.git",
    "directory": "packages/components/button"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "biome format --write ./src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jarl/typescript-config": "workspace:*",
    "@jarl/vite-config": "workspace:*",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-lib-inject-css": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@jarl/react-utils": "workspace:*",
    "@jarl/utils": "workspace:*",
    "react": ">=19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
