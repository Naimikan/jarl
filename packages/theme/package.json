{
  "name": "@jarl/theme",
  "version": "0.0.0",
  "type": "module",
  "description": "Official theme for  Jarl",
  "homepage": "https://naimikan.github.io/jarl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naimikan/jarl.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "biome format --write ./src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jarl/typescript-config": "workspace:*",
    "@jarl/vite-config": "workspace:*",
    "@jarl/utils": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
