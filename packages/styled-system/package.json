{
  "name": "@jarl/styled-system",
  "version": "0.0.0",
  "description": "Motor de estilos generado por Panda CSS para el sistema Jarl",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "import": "./dist/css/index.mjs"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.ts",
      "import": "./dist/jsx/index.mjs"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "panda codegen && panda cssgen",
    "lint": "biome format --write panda.config.ts"
  },
  "devDependencies": {
    "@jarl/presets": "workspace:*",
    "@pandacss/dev": "latest"
  }
}
